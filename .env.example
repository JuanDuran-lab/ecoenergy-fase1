# ---------------------------------------------------------------------------
# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se versiona (está en .gitignore).
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=coloca-aqui-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos: sqlite (por defecto) o postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Contraseñas de los usuarios de prueba creados por "python manage.py seed_data".
# Deben cumplir la política: mínimo 10 caracteres, mayúscula, minúscula,
# número y carácter especial.
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_READER_PASSWORD=
