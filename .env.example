# ---------------------------------------------------------------------------
# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se versiona (está en .gitignore).
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=coloca-aqui-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En AWS: DJANGO_CSRF_TRUSTED_ORIGINS=http://<IP-o-dominio>
DJANGO_CSRF_TRUSTED_ORIGINS=
# True solo si el sitio tiene HTTPS configurado
DJANGO_USE_HTTPS=False
# Carpeta de imágenes subidas (por defecto ./media)
DJANGO_MEDIA_ROOT=

# Base de datos: sqlite (por defecto) o postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Contraseñas de los usuarios de prueba creados por "python manage.py seed_data".
# Deben cumplir la política: mínimo 10 caracteres, mayúscula, minúscula,
# número y carácter especial.
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_READER_PASSWORD=

# Correo saliente (recuperación de contraseña). Si EMAIL_HOST está vacío,
# el correo se imprime en la consola/terminal (modo desarrollo).
# Ejemplo Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=tu_correo@gmail.com, EMAIL_HOST_PASSWORD=<contraseña de aplicación>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EcoEnergy <no-reply@ecoenergy.local>

# Correos de los usuarios de prueba. Para demostrar la recuperación de
# contraseña, usa un correo real al que tengas acceso.
SEED_ADMIN_EMAIL=admin@ecoenergy.demo
SEED_SUPERVISOR_EMAIL=supervisor@ecoenergy.demo
SEED_READER_EMAIL=lector@ecoenergy.demo
